local deBounce = false -- Evita abrir várias janelas ao mesmo tempo se o jogador pisar muito rápido

local function aoPisar(objetoTocado)
	local personagem = objetoTocado.Parent
	local jogador = Players:GetPlayerFromCharacter(personagem)
	
	if jogador and not deBounce then
		deBounce = true
		
		-- Abre a janela oficial do Roblox para o jogador comprar com Robux
		MarketplaceService:PromptProductPurchase(jogador, ID_PRODUTO_100_PONTOS)
		
		task.wait(2) -- Tempo de espera antes de permitir ativar o bloco de novo
		deBounce = false
	end
end

