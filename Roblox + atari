-- Configurações da Câmera Atari
local DISTANCIA_CAMERA = 30 -- Distância (em blocos) que a câmera fica afastada do jogador
local ALTURA_CAMERA = 4      -- Altura extra para a câmera não ficar grudada no chão

-- Altera o tipo da câmera para podermos controlá-la via script
camera.CameraType = Enum.CameraType.Scriptable

local function atualizarCamera()
	local character = player.Character
	if not character then return end
	
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end
	
	local posicaoJogador = rootPart.Position
	
	-- Mantém a câmera alinhada no eixo X e Y do jogador, mas travada no eixo Z
	-- Isso cria o visual perfeito de jogo de plataforma/lateral clássico
	local posicaoAlvo = Vector3.new(posicaoJogador.X, posicaoJogador.Y + ALTURA_CAMERA, posicaoJogador.Z + DISTANCIA_CAMERA)
	
	-- Faz a câmera olhar diretamente para onde o jogador está
	local olharPara = Vector3.new(posicaoJogador.X, posicaoJogador.Y + ALTURA_CAMERA, posicaoJogador.Z)
	
	-- Atualiza a posição e rotação da câmera de forma suave
	camera.CFrame = CFrame.lookAt(posicaoAlvo, olharPara)
end

-- Roda a função em cada frame do jogo para garantir que a câmera não se atrase
